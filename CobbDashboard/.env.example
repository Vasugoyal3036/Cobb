DB_SERVER=localhost
DB_NAME=RPD_AVATAR01_NEW_ST_POS
DB_INSTANCE=SQLEXPRESS
DB_USER=
DB_PASSWORD=
PORT=5000
JWT_SECRET=change_this_to_a_random_secret

# Store Identity
STORE_ID=MY_STORE_001
STORE_NAME=My Fashion Store

# Firebase Cloud Sync (OPTIONAL)
# If you want phone access via Firebase, place your firebase-admin.json
# service account key file in this folder and set the project ID below.
# If left blank, cloud sync is disabled — phone access works only via tunnel.
FIREBASE_PROJECT_ID=

# Tunnel Configuration (for phone access without Firebase)
# The tunnel link is auto-generated when you click "Share to Phone" in the dashboard.
# You can also set a custom subdomain if using Cloudflare Tunnel.
TUNNEL_SUBDOMAIN=
