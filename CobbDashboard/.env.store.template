# ==============================================================================
# COBB STORE AUTOMATION & CRM CONFIGURATION
# ==============================================================================

# --- Store Identity ---
# Unique ID in Firebase (e.g., DEMO_STORE_001, STORE_NIGDHU_002)
STORE_ID=STORE_NIGDHU_002

# Human-readable store name shown on bills, phone notifications, and WhatsApp alerts
STORE_NAME=Cobb Nigdhu

# Store location / address
STORE_LOCATION=Main Market, Nigdhu

# Short Store Code (e.g., PUNDRI, NIGDHU)
STORE_CODE=NIGDHU

# --- POS Database Configuration (MS SQL) ---
# Default Cobb setup is localhost or localhost\SQLEXPRESS with Windows Authentication
DB_SERVER=localhost\\SQLEXPRESS
DB_NAME=RPD_AVATAR01_NEW_ST_POS
DB_USER=
DB_PASSWORD=

# --- Server Ports ---
PORT=5000
WHATSAPP_GATEWAY_PORT=3000

# --- Owner WhatsApp Alert Recipients ---
OWNER_WHATSAPP_NUMBERS=9138122820,8708788707,9034522000,9466422821
WHATSAPP_GATEWAY_URL=http://localhost:3000/send

# --- AI Intelligence (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
