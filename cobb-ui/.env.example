VITE_API_URL=http://localhost:5000
VITE_DEFAULT_STORE_ID=MY_STORE_001

# Firebase Configuration (OPTIONAL)
# If you want phone access via Firebase cloud mirror, create a Firebase project
# at https://console.firebase.google.com and paste your config values below.
# If left blank, the app runs fully offline — phone access works only via tunnel link.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
